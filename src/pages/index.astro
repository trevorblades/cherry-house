---
import { SiInstagram } from "@icons-pack/react-simple-icons";
import Logo from "../assets/logo.svg";
import { NewsletterForm } from "../components/NewsletterForm";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="grid grid-rows-[1fr_auto_1fr] py-2.5 min-h-dvh">
    <div />
    <div class="flex flex-col gap-7.5 md:gap-15 items-center">
      <Logo class="w-52.5 md:w-90" />
      <p
        class="uppercase font-medium tracking-wide text-xs md:text-lg leading-tight text-center"
      >
        Cool fuckin' type is the mission. <br>
        Launching 2026.
      </p>
    </div>
    <div class="flex justify-center items-center flex-col">
      <NewsletterForm client:load />
    </div>
  </div>
  <a
    href="https://www.instagram.com/cherryhousetype"
    class="absolute top-5 right-5 p-1 hover:text-purple"
    target="_blank"
    rel="noopener"
  >
    <SiInstagram className="size-7" />
  </a>
</Layout>
